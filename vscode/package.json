{
  "name": "stickai",
  "displayName": "StickAI",
  "description": "Your desktop stickmen help with code: explain it, comment it, explain errors and answer questions in a side panel.",
  "version": "0.3.4",
  "publisher": "stickai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stickai.run",
        "title": "%cmd.run%",
        "category": "StickAI",
        "icon": "$(play-circle)"
      },
      {
        "command": "stickai.explain",
        "title": "%cmd.explain%",
        "category": "StickAI"
      },
      {
        "command": "stickai.comment",
        "title": "%cmd.comment%",
        "category": "StickAI"
      },
      {
        "command": "stickai.diagnose",
        "title": "%cmd.diagnose%",
        "category": "StickAI"
      },
      {
        "command": "stickai.review",
        "title": "%cmd.review%",
        "category": "StickAI"
      },
      {
        "command": "stickai.explainRun",
        "title": "%cmd.explainRun%",
        "category": "StickAI"
      },
      {
        "command": "stickai.quiz",
        "title": "%cmd.quiz%",
        "category": "StickAI"
      },
      {
        "command": "stickai.hint",
        "title": "%cmd.hint%",
        "category": "StickAI"
      },
      {
        "command": "stickai.ask",
        "title": "%cmd.ask%",
        "category": "StickAI"
      },
      {
        "command": "stickai.showPanel",
        "title": "%cmd.showPanel%",
        "category": "StickAI"
      },
      {
        "command": "stickai.reconnect",
        "title": "%cmd.reconnect%",
        "category": "StickAI"
      }
    ],
    "keybindings": [
      {
        "command": "stickai.explain",
        "key": "ctrl+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "stickai.comment",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "stickai.ask",
        "key": "ctrl+alt+q"
      },
      {
        "command": "stickai.hint",
        "key": "ctrl+alt+h",
        "when": "editorTextFocus"
      },
      {
        "command": "stickai.review",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "stickai.explainRun",
        "key": "ctrl+alt+t",
        "when": "editorTextFocus || terminalFocus"
      },
      {
        "command": "stickai.run",
        "key": "ctrl+alt+enter",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "stickai.run",
          "group": "1_stickai@0"
        },
        {
          "command": "stickai.explain",
          "group": "1_stickai@1"
        },
        {
          "command": "stickai.comment",
          "group": "1_stickai@2",
          "when": "!editorReadonly"
        },
        {
          "command": "stickai.diagnose",
          "group": "1_stickai@3"
        },
        {
          "command": "stickai.ask",
          "group": "1_stickai@4"
        },
        {
          "command": "stickai.hint",
          "group": "1_stickai@5"
        },
        {
          "command": "stickai.quiz",
          "group": "1_stickai@6"
        },
        {
          "command": "stickai.review",
          "group": "1_stickai@7"
        },
        {
          "command": "stickai.explainRun",
          "group": "1_stickai@8"
        }
      ],
      "terminal/context": [
        {
          "command": "stickai.explainRun",
          "group": "1_stickai"
        }
      ],
      "editor/title": [
        {
          "command": "stickai.run",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(c|cpp|cc|py|js)$/"
        }
      ]
    }
  }
}
